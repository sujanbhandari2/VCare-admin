# Copy this file to .env.dev, .env.qa, .env.uat, and .env.prod (and optionally .env)
# then update values per environment.
#
# BASE_URL is the API host root. The app appends api/v1/ automatically for all flavors.
# Auth identify example: {BASE_URL}api/v1/auth/identify/

# Flavor hint for Health Messenger tenant prefix (DEV_ / QA_ / UAT_ / PROD_)
ENV=DEV



# Sent on every admin login when the deployment is single-tenant

# Mock template API (legacy endpoints only — not for Vitafy auth):
# BASE_URL=https://mock-forge-express.lovable.app/api/public/mock/flutter-template-l4r8p7i9/dev/

# Generic chat (health_messenger_ui)
# Tenant id comes from login/auth/me `user.currentTenant.id` (not env).
VITE_API_URL=https://
VITE_SOCKET_URL=https://
